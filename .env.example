# Supabase
# URL del proyecto Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública anon (Project Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nota: Supabase recomienda usar la clave pública "anon" para clientes web.
# En versiones recientes también puede exponerse como NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Si tu proyecto usa esa variante, documenta y utiliza la configuración vigente.
# No incluir claves de servicio (service_role) en el cliente.